# Hawksroost — server settings. Copy to .env (scripts/install.sh does this).
# Everything else (cameras, Tempest, Starlink, email, Google sign-in, radio)
# is set up in the app: Settings.

# Cloudflare API token that may edit DNS for hawksroost.live
# (Cloudflare → My Profile → API Tokens → Create Token → "Edit zone DNS").
# Keeps the DNS records pointed at Starlink's public IP.
CLOUDFLARE_API_TOKEN=

# Addresses served by Caddy (HTTPS certificates are automatic).
HAWK_DOMAIN=hawksroost.live
HA_DOMAIN=ha.hawksroost.live

# Public address of the app (used in invite links before it's set in the app).
HAWK_PUBLIC_URL=https://hawksroost.live

# Time zone (Arizona has no daylight saving).
TZ=America/Phoenix

# Port for LAN access: http://<laptop-ip>:8080 (Caddy also uses it internally).
HAWK_LAN_PORT=8080

# Optional extras. "radio" turns on the radio recorder (scripts/radio-on.sh sets it).
COMPOSE_PROFILES=
