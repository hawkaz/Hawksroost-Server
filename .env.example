# Hawksroost — server settings. Copy to .env (scripts/setup.sh does this).
# Everything else (cameras, Tempest, Starlink, email, Google sign-in, radio)
# is set up in the app: Settings.

# Cloudflare Tunnel token (Cloudflare dashboard → Zero Trust → Networks → Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# Public address of the app (used in invite links before it's set in the app).
HAWK_PUBLIC_URL=https://hawksroost.live

# Time zone (Arizona has no daylight saving).
TZ=America/Phoenix

# Port for LAN access: http://<laptop-ip>:8080
HAWK_LAN_PORT=8080

# Optional extras. "radio" turns on the radio recorder (scripts/radio-on.sh sets it).
COMPOSE_PROFILES=
