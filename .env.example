# Hawksroost Server — environment
# Copy to .env and adjust.  (.env is gitignored — never commit secrets.)
#
#   cp .env.example .env

# Timezone for recording filename timestamps.
# Arizona does NOT observe DST -> America/Phoenix.
TZ=America/Phoenix

